---
import { t, type Locale } from '../lib/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<dialog class="lightbox" data-lightbox aria-labelledby="lightbox-title">
  <div class="inner">
    <button class="close" type="button" data-lightbox-close>
      <span class="visually-hidden">{t(locale, 'video.close')}</span>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"></path>
      </svg>
    </button>
    <div class="stage" data-lightbox-stage>
      <video data-lightbox-video-el controls playsinline preload="none" hidden></video>
    </div>
    <p id="lightbox-title" class="title" data-lightbox-title-el></p>
  </div>
</dialog>

<script>
  import '../scripts/lightbox'
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(15 14 13 / 0.96);
    color: var(--on-dark);
  }

  .lightbox::backdrop {
    background: rgb(15 14 13 / 0.6);
  }

  .lightbox[open] {
    display: grid;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] {
      animation: lightbox-in 0.3s var(--ease);
    }
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
  }

  .inner {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.75rem;
    padding: 4rem var(--gutter) max(1.25rem, env(safe-area-inset-bottom));
    min-height: 0;
  }

  .stage {
    display: grid;
    place-items: center;
    min-height: 0;
  }

  .stage video,
  .stage :global(img) {
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--radius);
    background: #000;
  }

  .stage [hidden] {
    display: none;
  }

  .title {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--on-dark-soft);
    text-wrap: balance;
  }

  .close {
    position: absolute;
    top: 0.75rem;
    right: var(--gutter);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--on-dark);
    color: var(--dark);
  }

  .close:focus-visible {
    outline-color: var(--accent-on-dark);
  }
</style>
