---
import Base from '../layouts/Base.astro'
import About from './About.astro'
import Acting from './Acting.astro'
import BrandsStrip from './BrandsStrip.astro'
import BrandWork from './BrandWork.astro'
import Contact from './Contact.astro'
import Header from './Header.astro'
import Hero from './Hero.astro'
import Marquee from './Marquee.astro'
import Services from './Services.astro'
import VideoLightbox from './VideoLightbox.astro'
import { t, type UiKey } from '../lib/i18n'
import { sized } from '../lib/image'
import type { SiteData } from '../lib/types'

interface Props {
  data: SiteData
}

const { data } = Astro.props
const { locale } = data

const role = data.tagline || t(locale, 'meta.role')

// Una sección sin contenido no se pinta ni se enlaza en el menú.
const has = {
  work: data.videos.length > 0,
  brands: data.showBrands && data.brands.length > 0,
  services: data.services.length > 0,
  acting: data.actingWorks.length > 0,
  about: Boolean(data.aboutText || data.aboutPhoto),
}

const sections = (
  [
    has.work && { id: 'trabajo', label: 'nav.work' },
    has.services && { id: 'servicios', label: 'nav.services' },
    has.acting && { id: 'actriz', label: 'nav.acting' },
    has.about && { id: 'sobre-mi', label: 'nav.about' },
    { id: 'contacto', label: 'nav.contact' },
  ] as (false | { id: string; label: UiKey })[]
).filter((s) => s !== false)
---

<Base locale={locale} title={`Jimena Melendez — ${role}`} description={role} ogImage={data.shareImage && sized(data.shareImage.url, 1200)}>
  <a class="skip-link" href="#contenido">{t(locale, 'skip')}</a>
  <Header locale={locale} sections={sections} />
  <main id="contenido">
    <Hero data={data} />
    <Marquee words={data.marqueeWords} />
    {has.work && <BrandWork data={data} />}
    {has.brands && <BrandsStrip data={data} />}
    {has.services && <Services data={data} />}
    {has.acting && <Acting data={data} />}
    {has.about && <About data={data} />}
    <Contact data={data} />
  </main>
  <VideoLightbox locale={locale} />
</Base>

<script>
  import '../scripts/animations'
</script>
