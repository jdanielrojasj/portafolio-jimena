---
import Photo from './Photo.astro'
import { t } from '../lib/i18n'
import type { SiteData } from '../lib/types'

interface Props {
  data: SiteData
}

const { data } = Astro.props
const { locale, heroPhotos, heroVideoUrl } = data
const [left, right] = heroPhotos
const photos = [left, right].filter(Boolean).length
const pieces = photos + (heroVideoUrl ? 1 : 0)
const tagline = data.tagline || t(locale, 'meta.role')
// Hay algo que se mueve solo: el montaje de portada o la franja de palabras.
const moves = Boolean(heroVideoUrl) || data.marqueeWords.length > 0

// La portada ocupa exactamente una pantalla. Las piezas se dimensionan por
// su altura (H): el vídeo 9:16 mide H de alto y las fotos 4:5, SIDE · H.
// "units" es el ancho total en unidades de H, para que el trío quepa
// también a lo ancho: H = min(alto disponible, ancho disponible / units).
const SIDE = heroVideoUrl ? 0.68 : 1
const units = (heroVideoUrl ? 9 / 16 : 0) + photos * (4 / 5) * SIDE
// Fotos pegadas al vídeo: en móvil se solapan con él (ver --overlap en CSS).
const sides = heroVideoUrl ? photos : 0
const trioStyle = `--units: ${units.toFixed(4)}; --gaps: ${Math.max(pieces - 1, 0)}; --side: ${SIDE}; --sides: ${sides}`
---

<section id="portada" class="hero" data-hero>
  <div class="wrap">
    <h1 class="name" data-hero-name>
      <span class="line"><span>Jimena</span></span>
      <span class="line"><span>Meléndez</span></span>
    </h1>

    <div class="intro" data-hero-intro>
      <p class="tagline" lang={data.tagline ? data.taglineLang : undefined}>{tagline}</p>
      <a class="button" href="#contacto">
        {t(locale, 'cta.work')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    {
      pieces > 0 && (
        <div class="trio" style={trioStyle} data-pieces={pieces}>
          {left && (
            <figure class="piece piece--side" data-hero-piece data-speed="-0.12">
              <Photo img={left} sizes="(min-width: 48rem) 22vw, 30vw" eager />
            </figure>
          )}
          {heroVideoUrl && (
            <figure class="piece piece--main" data-hero-piece data-speed="0.06">
              <video
                src={heroVideoUrl}
                muted
                loop
                playsinline
                preload="metadata"
                disablepictureinpicture
                aria-label={t(locale, 'hero.reel')}
                data-hero-video
              />
            </figure>
          )}
          {right && (
            <figure class="piece piece--side" data-hero-piece data-speed="-0.2">
              <Photo img={right} sizes="(min-width: 48rem) 22vw, 30vw" eager />
            </figure>
          )}
        </div>
      )
    }

    {
      moves && (
        // Oculto hasta que el script lo activa: sin JavaScript o con
        // movimiento reducido, nada se mueve solo y no hace falta.
        <button class="motion-toggle" type="button" aria-pressed="false" data-motion-toggle hidden>
          <svg class="icon-pause" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" />
          </svg>
          <svg class="icon-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
          </svg>
          <span>{t(locale, 'motion.pause')}</span>
        </button>
      )
    }
  </div>
</section>

<style>
  /* ---------- Una pantalla exacta ---------- */
  .hero {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100svh;
    /* En pantallas muy bajas (un móvil en horizontal) se permite scroll. */
    min-height: 34rem;
    padding-top: calc(var(--header-h) + clamp(0.5rem, 2.5svh, 2rem));
    padding-bottom: clamp(1rem, 3svh, 2.25rem);
  }

  .hero > .wrap {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    row-gap: clamp(0.75rem, 2.5svh, 1.75rem);
  }

  /* ---------- Nombre ---------- */
  .name {
    font-family: var(--font-display);
    font-weight: 400;
    /* Limitado también por el alto, para dejar sitio al trío. */
    font-size: min(var(--text-hero), 13svh);
    line-height: 0.86;
    letter-spacing: -0.045em;
    font-variation-settings: 'opsz' 144;
    margin-left: -0.04em;
  }

  /* Cada línea recorta su texto para que pueda entrar deslizándose. */
  .name .line {
    display: block;
    overflow: hidden;
    padding: 0.1em 0.08em 0.14em;
    margin: -0.1em -0.08em -0.14em;
  }

  .name .line > span {
    display: block;
  }

  .name .line:last-child {
    text-align: right;
  }

  /* En pantallas anchas, el nombre en una sola línea. */
  @media (min-width: 48rem) {
    .name {
      display: flex;
      flex-wrap: wrap;
      column-gap: 0.24em;
      font-size: min(10.5vw, 19svh);
    }

    .name .line:last-child {
      text-align: left;
    }
  }

  /* ---------- Línea de presentación y contacto ---------- */
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }

  .tagline {
    max-width: 22ch;
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--ink-soft);
    text-wrap: balance;
  }

  @media (min-width: 48rem) {
    .tagline {
      max-width: none;
    }
  }

  /* ---------- Trío: foto · vídeo · foto ---------- */
  .trio {
    container-type: size;
    --gap: clamp(0.5rem, 1.6vw, 1.5rem);
    /* Parte de cada foto que queda detrás del vídeo, en unidades de H. */
    --overlap: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--gap);
    min-height: 0;
  }

  .piece {
    /* Alto del vídeo: lo que quepa de alto o de ancho, lo que sea menor. */
    --h: min(100cqh, (100cqw - var(--gaps) * var(--gap)) / (var(--units) - var(--sides) * var(--overlap)));
    flex: none;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-2);
    will-change: transform;
  }

  .piece--main {
    height: var(--h);
    aspect-ratio: 9 / 16;
    background: var(--dark);
    box-shadow: 0 1.5rem 3.5rem -1.5rem rgb(27 26 24 / 0.45);
  }

  .piece--side {
    height: calc(var(--h) * var(--side));
    aspect-ratio: 4 / 5;
  }

  /* En pantallas estrechas, collage: las fotos asoman por detrás del
     vídeo, una algo más arriba y otra más abajo, y el vídeo gana tamaño. */
  @media (max-width: 47.99rem) {
    .trio {
      --gap: 0px;
      --overlap: 0.2;
    }

    .piece--main {
      position: relative;
      z-index: 1;
    }

    .piece--side + .piece--main,
    .piece--main + .piece--side {
      margin-left: calc(var(--overlap) * var(--h) * -1);
    }

    .piece--side:first-child {
      translate: 0 -14%;
    }

    .piece--side:last-child {
      translate: 0 14%;
    }
  }

  .piece :global(img),
  .piece video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Botón de pausa ---------- */
  .motion-toggle {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .motion-toggle[hidden] {
    display: none;
  }

  .motion-toggle:hover {
    color: var(--ink);
  }

  .motion-toggle .icon-play,
  .motion-toggle[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .motion-toggle[aria-pressed='true'] .icon-play {
    display: block;
  }

  /* En móvil, solo el icono: el texto sigue ahí para lectores de pantalla. */
  @media (max-width: 47.99rem) {
    .motion-toggle {
      justify-content: center;
      width: 2.75rem;
      padding: 0;
      bottom: 0.5rem;
      right: 0.5rem;
      color: var(--ink);
    }

    .motion-toggle span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
