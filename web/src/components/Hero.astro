---
import Photo from './Photo.astro'
import { t } from '../lib/i18n'
import type { SiteData } from '../lib/types'

interface Props {
  data: SiteData
}

const { data } = Astro.props
const { locale, heroPhotos, heroVideoUrl } = data
const [left, right] = heroPhotos
const pieces = [left, heroVideoUrl ? 'video' : undefined, right].filter(Boolean).length
const tagline = data.tagline || t(locale, 'meta.role')
// Hay algo que se mueve solo: el montaje de portada o la franja de palabras.
const moves = Boolean(heroVideoUrl) || data.marqueeWords.length > 0
---

<section id="portada" class="hero" data-hero>
  <div class="wrap">
    <h1 class="name" data-hero-name>
      <span class="line"><span>Jimena</span></span>
      <span class="line"><span>Meléndez</span></span>
    </h1>

    <div class="intro" data-hero-intro>
      <p class="tagline" lang={data.tagline ? data.taglineLang : undefined}>{tagline}</p>
      <a class="button" href="#contacto">
        {t(locale, 'cta.work')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    {
      pieces > 0 && (
        <div class="trio" data-pieces={pieces}>
          {left && (
            <figure class="piece piece--side" data-hero-piece data-speed="-0.12">
              <Photo img={left} sizes="(min-width: 60rem) 22rem, 30vw" eager />
            </figure>
          )}
          {heroVideoUrl && (
            <figure class="piece piece--main" data-hero-piece data-speed="0.06">
              <video
                src={heroVideoUrl}
                muted
                loop
                playsinline
                preload="metadata"
                disablepictureinpicture
                aria-label={t(locale, 'hero.reel')}
                data-hero-video
              />
            </figure>
          )}
          {right && (
            <figure class="piece piece--side" data-hero-piece data-speed="-0.2">
              <Photo img={right} sizes="(min-width: 60rem) 22rem, 30vw" eager />
            </figure>
          )}
        </div>
      )
    }

    {
      moves && (
        // Oculto hasta que el script lo activa: sin JavaScript o con
        // movimiento reducido, nada se mueve solo y no hace falta.
        <button class="motion-toggle" type="button" aria-pressed="false" data-motion-toggle hidden>
          <svg class="icon-pause" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" />
          </svg>
          <svg class="icon-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
            <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
          </svg>
          <span>{t(locale, 'motion.pause')}</span>
        </button>
      )
    }
  </div>
</section>

<style>
  .motion-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin: clamp(1rem, 3vw, 1.75rem) 0 0 auto;
    padding: 0.5rem 0.25rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .motion-toggle[hidden] {
    display: none;
  }

  .motion-toggle:hover {
    color: var(--ink);
  }

  .motion-toggle .icon-play,
  .motion-toggle[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .motion-toggle[aria-pressed='true'] .icon-play {
    display: block;
  }

  .hero {
    padding-top: calc(var(--header-h) + clamp(1.25rem, 4vw, 3rem));
    padding-bottom: clamp(3rem, 8vw, 7rem);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-hero);
    line-height: 0.86;
    letter-spacing: -0.045em;
    font-variation-settings: 'opsz' 144;
    margin-left: -0.04em;
  }

  /* Cada línea recorta su texto para que pueda entrar deslizándose. */
  .name .line {
    display: block;
    overflow: hidden;
    padding: 0 0.08em 0.14em;
    margin: 0 -0.08em -0.14em;
  }

  .name .line > span {
    display: block;
  }

  .name .line:last-child {
    text-align: right;
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(1.5rem, 4vw, 2.75rem);
  }

  .tagline {
    max-width: 22ch;
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--ink-soft);
    text-wrap: balance;
  }

  .trio {
    display: grid;
    grid-template-columns: 1fr 1.32fr 1fr;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
    max-width: 66rem;
    margin: clamp(2rem, 6vw, 4.5rem) auto 0;
  }

  .trio[data-pieces='2'] {
    grid-template-columns: 1fr 1.32fr;
    max-width: 44rem;
  }

  .trio[data-pieces='1'] {
    grid-template-columns: minmax(0, 24rem);
    justify-content: center;
  }

  .piece {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--paper-2);
    will-change: transform;
  }

  .piece--side {
    aspect-ratio: 4 / 5;
  }

  .piece--main {
    aspect-ratio: 9 / 16;
    background: var(--dark);
    box-shadow: 0 1.5rem 3.5rem -1.5rem rgb(27 26 24 / 0.45);
  }

  /* Sin vídeo, las fotos ocupan el protagonismo con el mismo alto. */
  .trio:not(:has(.piece--main)) {
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    max-width: 44rem;
  }

  .piece :global(img),
  .piece video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
