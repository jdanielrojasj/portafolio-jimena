---
import { LOCALES, localePath, t, type Locale, type UiKey } from '../lib/i18n'

interface Props {
  locale: Locale
  /** Secciones presentes en la página, en orden. */
  sections: { id: string; label: UiKey }[]
}

const { locale, sections } = Astro.props
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="mark" href={localePath(locale)} aria-label={`Jimena Melendez — ${t(locale, 'nav.home')}`}>JM</a>

    <nav id="site-nav" class="nav" aria-label={t(locale, 'nav.menu')} data-nav>
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={`#${s.id}`}>{t(locale, s.label)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <ul class="lang" aria-label={t(locale, 'lang.switch')}>
        {
          LOCALES.map((l) => (
            <li>
              <a href={localePath(l)} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined} data-lang={l}>
                {l.toUpperCase()}
              </a>
            </li>
          ))
        }
      </ul>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="visually-hidden">{t(locale, 'nav.menu')}</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const nav = document.querySelector<HTMLElement>('[data-nav]')

  if (header && toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open))
      header.toggleAttribute('data-open', open)
    }
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'))
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false)
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false)
        toggle.focus()
      }
    })

    // El selector de idioma conserva la sección en la que está la visita.
    document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((a) =>
      a.addEventListener('click', () => {
        if (location.hash) {
          a.hash = location.hash
          return
        }
        // Sin ancla en la dirección: la sección que ocupa ahora la pantalla.
        const line = header.offsetHeight + window.innerHeight / 3
        const current = [...document.querySelectorAll<HTMLElement>('main > section[id]')]
          .filter((s) => s.getBoundingClientRect().top <= line)
          .pop()
        if (current && current.id !== 'portada') a.hash = current.id
      }),
    )

    // La barra gana fondo al dejar la parte alta de la página.
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8)
    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .site-header[data-scrolled],
  .site-header[data-open] {
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  .mark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
    padding: 0.5rem 0.25rem;
    margin-left: -0.25rem;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lang {
    display: flex;
    align-items: center;
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: 2px;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .lang a {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.25rem;
    padding: 0 0.75rem;
    border-radius: 999px;
    text-decoration: none;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .lang a[aria-current='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    border-radius: 999px;
  }

  .bars {
    display: grid;
    gap: 6px;
    width: 22px;
  }

  .bars i {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.3s var(--ease);
  }

  [data-open] .bars i:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  [data-open] .bars i:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Móvil: el menú es un panel que se despliega bajo la barra. */
  .nav {
    position: absolute;
    inset: var(--header-h) 0 auto 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding: 0.5rem var(--gutter) 1.5rem;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease),
      visibility 0s 0.25s;
  }

  [data-open] .nav {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }

  .nav a {
    display: block;
    padding: 0.85rem 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.1;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .nav li:last-child a {
    border-bottom: 0;
  }

  /* Sin JavaScript no hay botón que abra el panel: el menú queda a la vista bajo la barra. */
  :global(.no-js) .menu-toggle {
    display: none;
  }

  :global(.no-js) .site-header {
    position: static;
    height: auto;
  }

  :global(.no-js) .bar {
    flex-wrap: wrap;
    padding-block: 0.5rem;
  }

  :global(.no-js) .nav {
    position: static;
    order: 3;
    flex-basis: 100%;
    visibility: visible;
    opacity: 1;
    transform: none;
    padding: 0;
    border: 0;
    background: none;
  }

  :global(.no-js) .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  :global(.no-js) .nav a {
    padding: 0.6rem 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    border: 0;
  }

  @media (min-width: 56rem) {
    .menu-toggle {
      display: none;
    }

    .nav {
      position: static;
      visibility: visible;
      opacity: 1;
      transform: none;
      background: none;
      border: 0;
      padding: 0;
    }

    .nav ul {
      display: flex;
      gap: clamp(1rem, 2.4vw, 2.25rem);
    }

    .nav a {
      padding: 0.5rem 0;
      font-family: var(--font-body);
      font-size: var(--text-sm);
      font-weight: 500;
      border: 0;
      background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
      transition: background-size 0.3s var(--ease);
    }

    .nav a:hover {
      background-size: 100% 1px;
    }
  }
</style>
