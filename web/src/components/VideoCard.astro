---
import { sized } from '../lib/image'
import { t, type Locale } from '../lib/i18n'
import type { VideoItem } from '../lib/types'

interface Props {
  video: VideoItem
  /** Nombre visible del tipo de vídeo. */
  categoryTitle: string
  locale: Locale
}

const { video, categoryTitle, locale } = Astro.props
const meta = [video.brand, categoryTitle].filter(Boolean).join(' · ')
---

<li class="item" data-video-item data-category={video.category}>
  <button
    class="card"
    type="button"
    data-video-card
    data-id={video.id}
    data-category={video.category}
    data-lightbox-video={video.videoUrl}
    data-lightbox-title={video.title}
    aria-label={`${t(locale, 'video.play')}: ${video.title}`}
  >
    <span class="frame">
      {
        video.posterUrl ? (
          <img
            src={sized(video.posterUrl, 540)}
            srcset={`${sized(video.posterUrl, 360)} 360w, ${sized(video.posterUrl, 540)} 540w, ${sized(video.posterUrl, 810)} 810w`}
            sizes="(min-width: 60rem) 17rem, 62vw"
            alt=""
            loading="lazy"
            decoding="async"
          />
        ) : (
          // Sin imagen de portada: se muestra el primer instante del propio vídeo.
          <video src={`${video.videoUrl}#t=0.1`} preload="metadata" muted playsinline tabindex="-1" aria-hidden="true" />
        )
      }
      <span class="play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
      </span>
    </span>
  </button>
  <div class="caption">
    <h3 class="title">{video.title}</h3>
    {meta && <p class="meta">{meta}</p>}
  </div>
</li>

<style>
  .item {
    flex: none;
    width: min(62vw, 17rem);
    min-width: 0;
    scroll-snap-align: start;
  }

  .item[hidden] {
    display: none;
  }

  .card {
    display: block;
    width: 100%;
    border-radius: var(--radius);
    text-align: left;
  }

  .frame {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--dark);
  }

  .frame img,
  .frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .card:hover .frame img,
  .card:hover .frame video {
    transform: scale(1.04);
  }

  .play {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    transition:
      transform 0.3s var(--ease),
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .card:hover .play,
  .card:focus-visible .play {
    transform: scale(1.08);
    background: var(--accent);
    color: var(--paper);
  }

  .caption {
    padding-top: 0.85rem;
  }

  .title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .meta {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }
</style>
