---
import VideoCard from './VideoCard.astro'
import { t } from '../lib/i18n'
import type { SiteData } from '../lib/types'

interface Props {
  data: SiteData
}

const { data } = Astro.props
const { locale, videos, categories } = data
const titleOf = (slug: string) => categories.find((c) => c.slug === slug)?.title ?? ''
---

<section id="trabajo" class="section work" data-reveal>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">UGC</p>
      <h2 class="display">{t(locale, 'section.work')}</h2>
    </div>

    {
      categories.length > 1 && (
        <div class="filters" role="group" aria-label={t(locale, 'filter.label')} data-filters>
          <button class="filter" type="button" aria-pressed="true" data-filter="">
            {t(locale, 'filter.all')}
          </button>
          {categories.map((c) => (
            <button class="filter" type="button" aria-pressed="false" data-filter={c.slug}>
              {c.title}
            </button>
          ))}
        </div>
      )
    }
  </div>

  <ul class="rail" data-carousel>
    {videos.map((video) => <VideoCard video={video} categoryTitle={titleOf(video.category)} locale={locale} />)}
  </ul>
</section>

<script>
  import '../scripts/carousel'
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .filter {
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    max-width: 100%;
    overflow-wrap: anywhere;
    text-align: center;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .filter:hover {
    background: var(--paper-2);
  }

  .filter[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  /* El carril llega hasta el borde de la pantalla y se desliza con el dedo. */
  .rail {
    --edge: max(var(--gutter), (100vw - var(--max)) / 2);
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    overflow-x: auto;
    padding-inline: var(--edge);
    scroll-padding-inline: var(--edge);
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }
</style>
